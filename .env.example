# PostgreSQL connection (local dev; use host `postgres` when running via docker-compose)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pos_ai

# Application secret (generate a strong random value for production)
SECRET_KEY=change-me-to-a-long-random-string

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
